---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="LOE Supplement Tool"
  description="Dynamic LOE planning tool for standard FTE, fluctuating monthly FTE, multiple supplements, and account-level labor distribution."
>
  <section class="tool-shell">
    <div class="tool-hero">
      <p class="tool-eyebrow">Tools &amp; Templates</p>
      <h1>LOE Supplement Tool</h1>
      <p class="tool-intro">
        Model labor distribution across base salary, supplemental funding, monthly FTE changes,
        and multiple LOE accounts.
      </p>

      <div class="tool-download-callout no-print">
        <div class="tool-download-card">
          <div class="tool-download-copy">
            <p class="tool-download-label">Excel Templates Available</p>
            <h2>Prefer to work in Excel?</h2>
            <p>
              Download either the standard FTE version or the fluctuating monthly FTE version
              depending on how the labor distribution is structured.
            </p>
          </div>

          <div class="download-button-group">
            <a
              class="download-button"
              href="/downloads/LOE%20Supplement%20Planner_V1.2.xlsx"
              download
            >
              Standard FTE Template
            </a>

            <a
              class="download-button"
              href="/downloads/LOE%20Supplement%20Planner_V2.2.xlsx"
              download
            >
              Fluctuating FTE Template
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="tool-card tool-card-instructions print-section">
      <div class="section-heading">
        <h2>How to Use This Tool</h2>
        <p>
          Enter the base salary, standard FTE, fringe rate, supplement structure, and LOE account
          allocation. The tool will combine monthly FTE with each account’s LOE percentage.
        </p>
      </div>

      <div class="instruction-grid">
        <div class="instruction-item">
          <strong>Monthly FTE</strong>
          <p>
            Use standard FTE as the default. Enter monthly overrides only when FTE changes for a
            specific month.
          </p>
        </div>

        <div class="instruction-item">
          <strong>LOE accounts</strong>
          <p>
            Add one row per account or project. Each account receives its own LOE percentage and
            projected salary/fringe calculation.
          </p>
        </div>

        <div class="instruction-item">
          <strong>Supplement structure</strong>
          <p>
            Add one or more supplement lines with effective dates. Each supplement can either scale
            with FTE or remain fixed.
          </p>
        </div>
      </div>
    </div>

    <div class="tool-card print-section">
      <div class="section-heading">
        <h2>Projection Details</h2>
        <p>Enter the projection period to generate the monthly rows automatically.</p>
      </div>

      <div class="input-grid input-grid-3">
        <label class="field">
          <span>Projection start date</span>
          <input id="projectionStart" type="date" />
        </label>

        <label class="field">
          <span>Projection end date</span>
          <input id="projectionEnd" type="date" />
        </label>

        <label class="field">
          <span>Name / scenario label</span>
          <input id="scenarioLabel" type="text" placeholder="Optional" />
        </label>
      </div>

      <p class="field-note">
        This tool uses month-based proration. Enter the last day of the projection period when
        modeling a full month. This calculator is intended for planning purposes and should be
        reviewed against institutional payroll and labor distribution requirements.
      </p>
    </div>

    <div class="tool-card print-section">
      <div class="section-heading">
        <h2>Key Inputs</h2>
        <p>These values drive the base salary, FTE, and fringe calculations.</p>
      </div>

      <div class="input-grid input-grid-3">
        <label class="field">
          <span>Annual base salary</span>
          <input
            id="baseSalary"
            type="text"
            inputmode="decimal"
            placeholder="$100,000.00"
            autocomplete="off"
          />
        </label>

        <label class="field">
          <span>Standard FTE %</span>
          <input
            id="standardFte"
            type="text"
            inputmode="decimal"
            placeholder="100.00%"
            autocomplete="off"
          />
          <small class="field-helper">Enter as a percentage, not a decimal.</small>
        </label>

        <label class="field">
          <span>Fringe rate %</span>
          <input
            id="fringeRate"
            type="text"
            inputmode="decimal"
            placeholder="30.00%"
            autocomplete="off"
          />
          <small class="field-helper">Enter as a percentage, not a decimal.</small>
        </label>
      </div>
    </div>

    <div class="tool-card print-section">
      <div class="section-heading section-heading-with-action">
        <div>
          <h2>Supplement Structure</h2>
          <p>
            Add supplement lines as needed. A supplement is active only during the months that fall
            within its effective date range.
          </p>
        </div>

        <button type="button" class="small-action-button no-print" id="addSupplementButton">
          Add Supplement
        </button>
      </div>

      <p class="field-note">
        Use this section for the supplement line itself. The online tool supports multiple
        supplement rows, but many scenarios may only need one.
      </p>

      <div class="scroll-hint no-print">
        Scroll horizontally to view all supplement columns.
      </div>

      <div class="table-wrap">
        <table class="results-table supplement-table">
          <thead>
            <tr>
              <th>Supplement Label</th>
              <th>Annual Amount</th>
              <th>Effective Start</th>
              <th>Effective End</th>
              <th>Scales with FTE?</th>
              <th>Notes</th>
              <th class="no-print">Action</th>
            </tr>
          </thead>
          <tbody id="supplementTableBody"></tbody>
        </table>
      </div>
    </div>

    <div class="tool-card print-section">
      <div class="section-heading section-heading-with-action">
        <div>
          <h2>LOE Account Allocation</h2>
          <p>
            Add each account or project receiving LOE. The account LOE percentage is applied to
            base salary and active supplements.
          </p>
        </div>

        <button type="button" class="small-action-button no-print" id="addAccountButton">
          Add Account
        </button>
      </div>

      <p class="field-note">
        Account LOE should be entered as a percentage. For example, enter 25 for 25.00%, not 0.25.
      </p>

      <div class="table-wrap">
        <table class="results-table account-table">
          <thead>
            <tr>
              <th>Account / Project Name</th>
              <th>Account Number</th>
              <th>LOE %</th>
              <th class="no-print">Action</th>
            </tr>
          </thead>
          <tbody id="accountTableBody"></tbody>
        </table>
      </div>
    </div>

    <div class="tool-card print-section">
      <div class="section-heading">
        <h2>Monthly FTE Overrides</h2>
        <p>
          Monthly overrides are optional. Blank fields use the standard FTE entered above.
        </p>
      </div>

      <div id="fteEmptyState" class="empty-state">
        Enter a projection start and end date to generate monthly FTE rows.
      </div>

      <div id="fteTableWrap" class="table-wrap" hidden>
        <table class="results-table">
          <thead>
            <tr>
              <th class="fy-col">Month</th>
              <th>Monthly FTE Override %</th>
              <th>FTE Used</th>
            </tr>
          </thead>
          <tbody id="fteTableBody"></tbody>
        </table>
      </div>
    </div>

    <div class="tool-card print-section">
      <div class="section-heading">
        <h2>Monthly Account Projection</h2>
        <p>
          This table combines monthly FTE, account LOE, base salary, active supplements, and fringe.
        </p>
      </div>

      <div id="projectionEmptyState" class="empty-state">
        Enter projection dates, key inputs, supplements, and LOE accounts to generate results.
      </div>

      <div id="projectionScrollHint" class="scroll-hint no-print" hidden>
        Scroll horizontally to view all monthly account projection columns.
      </div>

      <div id="projectionTableWrap" class="table-wrap" hidden>
        <table class="results-table wide-table">
          <thead>
            <tr>
              <th class="fy-col">Month</th>
              <th>Account</th>
              <th>Account Number</th>
              <th>LOE %</th>
              <th>FTE Used</th>
              <th>Base Salary</th>
              <th>Supplement Total</th>
              <th>Total Salary</th>
              <th>Fringe</th>
              <th>Total Cost</th>
            </tr>
          </thead>
          <tbody id="projectionTableBody"></tbody>
        </table>
      </div>
    </div>

    <div class="tool-card print-section">
      <div class="section-heading">
        <h2>Summary</h2>
        <p>High-level totals across all generated months and LOE accounts.</p>
      </div>

      <div id="summaryEmptyState" class="empty-state">
        Summary totals will appear once the projection is generated.
      </div>

      <div id="summaryGrid" class="summary-grid" hidden>
        <div class="summary-stack">
          <div class="summary-row summary-row-grant">
            <div class="summary-item">
              <span class="summary-label">Total Base Salary</span>
              <strong id="summaryBaseSalary">$0.00</strong>
            </div>

            <div class="summary-item">
              <span class="summary-label">Total Supplement</span>
              <strong id="summarySupplement">$0.00</strong>
            </div>

            <div class="summary-item">
              <span class="summary-label">Total Salary</span>
              <strong id="summaryTotalSalary">$0.00</strong>
            </div>
          </div>

          <div class="summary-row summary-row-costshare">
            <div class="summary-item">
              <span class="summary-label">Total Fringe</span>
              <strong id="summaryFringe">$0.00</strong>
            </div>

            <div class="summary-item">
              <span class="summary-label">Total Projected Cost</span>
              <strong id="summaryTotalCost">$0.00</strong>
            </div>

            <div class="summary-item">
              <span class="summary-label">Total LOE Allocated</span>
              <strong id="summaryTotalLoe">0.00%</strong>
            </div>
          </div>

          <div class="summary-row summary-row-neutral">
            <div class="summary-item">
              <span class="summary-label">Average FTE Used</span>
              <strong id="summaryAverageFte">0.00%</strong>
            </div>

            <div class="summary-item">
              <span class="summary-label">Supplement Lines</span>
              <strong id="summarySupplementCount">0</strong>
            </div>

            <div class="summary-item">
              <span class="summary-label">LOE Account Lines</span>
              <strong id="summaryAccountCount">0</strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="tool-card print-section">
      <div class="section-heading">
        <h2>Account-Level Summary</h2>
        <p>Review total projected salary, supplement, fringe, and cost by account.</p>
      </div>

      <div id="accountSummaryEmptyState" class="empty-state">
        Account-level totals will appear once the projection is generated.
      </div>

      <div id="accountSummaryTableWrap" class="table-wrap" hidden>
        <table class="results-table">
          <thead>
            <tr>
              <th>Account</th>
              <th>Account Number</th>
              <th>LOE %</th>
              <th>Base Salary</th>
              <th>Supplement</th>
              <th>Total Salary</th>
              <th>Fringe</th>
              <th>Total Cost</th>
            </tr>
          </thead>
          <tbody id="accountSummaryTableBody"></tbody>
        </table>
      </div>
    </div>

    <div class="tool-print-actions no-print">
      <p class="tool-print-note">
        Need a clean record of the calculator output? Use the print dialog and choose
        <strong>Save as PDF</strong>.
      </p>
      <button type="button" class="print-button" onclick="window.print()">
        Print / Save as PDF
      </button>
    </div>
  </section>

  <script>
    const projectionStartInput = document.getElementById("projectionStart");
    const projectionEndInput = document.getElementById("projectionEnd");

    const baseSalaryInput = document.getElementById("baseSalary");
    const standardFteInput = document.getElementById("standardFte");
    const fringeRateInput = document.getElementById("fringeRate");

    const addSupplementButton = document.getElementById("addSupplementButton");
    const supplementTableBody = document.getElementById("supplementTableBody");

    const addAccountButton = document.getElementById("addAccountButton");
    const accountTableBody = document.getElementById("accountTableBody");

    const fteEmptyState = document.getElementById("fteEmptyState");
    const fteTableWrap = document.getElementById("fteTableWrap");
    const fteTableBody = document.getElementById("fteTableBody");

    const projectionEmptyState = document.getElementById("projectionEmptyState");
    const projectionScrollHint = document.getElementById("projectionScrollHint");
    const projectionTableWrap = document.getElementById("projectionTableWrap");
    const projectionTableBody = document.getElementById("projectionTableBody");

    const summaryEmptyState = document.getElementById("summaryEmptyState");
    const summaryGrid = document.getElementById("summaryGrid");

    const summaryBaseSalary = document.getElementById("summaryBaseSalary");
    const summarySupplement = document.getElementById("summarySupplement");
    const summaryTotalSalary = document.getElementById("summaryTotalSalary");
    const summaryFringe = document.getElementById("summaryFringe");
    const summaryTotalCost = document.getElementById("summaryTotalCost");
    const summaryTotalLoe = document.getElementById("summaryTotalLoe");
    const summaryAverageFte = document.getElementById("summaryAverageFte");
    const summarySupplementCount = document.getElementById("summarySupplementCount");
    const summaryAccountCount = document.getElementById("summaryAccountCount");

    const accountSummaryEmptyState = document.getElementById("accountSummaryEmptyState");
    const accountSummaryTableWrap = document.getElementById("accountSummaryTableWrap");
    const accountSummaryTableBody = document.getElementById("accountSummaryTableBody");

    let monthlyRows = [];

    function parseLocalDate(value) {
      if (!value) return null;
      const [year, month, day] = value.split("-").map(Number);
      return new Date(year, month - 1, day);
    }

    function parseNumber(value) {
      if (value === "" || value === null || value === undefined) return null;
      const cleaned = String(value).replace(/[$,%\s,]/g, "");
      if (cleaned === "") return null;
      const parsed = Number(cleaned);
      return Number.isFinite(parsed) ? parsed : null;
    }

    function formatCurrency(value) {
      return value.toLocaleString("en-US", {
        style: "currency",
        currency: "USD",
      });
    }

    function formatPercent(value) {
      return `${value.toFixed(2)}%`;
    }

    function formatMonth(date) {
      return date.toLocaleDateString("en-US", {
        month: "short",
        year: "numeric",
      });
    }

    function formatCurrencyInput(value) {
      const parsed = parseNumber(value);
      if (parsed === null) return "";
      return parsed.toLocaleString("en-US", {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
    }

    function formatPercentInput(value) {
      const parsed = parseNumber(value);
      if (parsed === null) return "";
      return `${parsed.toLocaleString("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      })}%`;
    }

    function attachFormattedInput(input, formatter) {
      if (!input) return;

      input.addEventListener("focus", () => {
        const parsed = parseNumber(input.value);
        input.value = parsed === null ? "" : String(parsed);
      });

      input.addEventListener("blur", () => {
        if (input.value.trim() === "") return;
        input.value = formatter(input.value);
        updateProjection();
      });
    }

    function attachTableCurrencyInput(input) {
      input.addEventListener("focus", () => {
        const parsed = parseNumber(input.value);
        input.value = parsed === null ? "" : String(parsed);
      });

      input.addEventListener("blur", () => {
        if (input.value.trim() !== "") {
          input.value = formatCurrencyInput(input.value);
        }
        updateProjection();
      });

      input.addEventListener("input", updateProjection);
    }

    function attachTablePercentInput(input) {
      input.addEventListener("focus", () => {
        const parsed = parseNumber(input.value);
        input.value = parsed === null ? "" : String(parsed);
      });

      input.addEventListener("blur", () => {
        if (input.value.trim() !== "") {
          input.value = formatPercentInput(input.value);
        }
        updateProjection();
      });

      input.addEventListener("input", updateProjection);
    }

    function getMonthStart(date) {
      return new Date(date.getFullYear(), date.getMonth(), 1);
    }

    function getMonthEnd(date) {
      return new Date(date.getFullYear(), date.getMonth() + 1, 0);
    }

    function addMonths(date, months) {
      return new Date(date.getFullYear(), date.getMonth() + months, 1);
    }

    function generateMonths(startDate, endDate) {
      const rows = [];
      let cursor = getMonthStart(startDate);
      const finalMonth = getMonthStart(endDate);

      while (cursor <= finalMonth) {
        rows.push({
          monthDate: new Date(cursor),
          monthEndDate: getMonthEnd(cursor),
          monthLabel: formatMonth(cursor),
        });

        cursor = addMonths(cursor, 1);
      }

      return rows;
    }

    function isSupplementActiveForMonth(supplement, monthDate, monthEndDate) {
      if (!supplement.amount) return false;

      const startDate = parseLocalDate(supplement.startDate);
      const endDate = parseLocalDate(supplement.endDate);

      if (!startDate && !endDate) return true;
      if (startDate && monthEndDate < startDate) return false;
      if (endDate && monthDate > endDate) return false;

      return true;
    }

    function addSupplementRow(defaults = {}) {
      const tr = document.createElement("tr");
      tr.className = supplementTableBody.children.length % 2 === 0 ? "row-blue-a" : "row-blue-b";

      tr.innerHTML = `
        <td>
          <input
            class="inline-table-input supplement-label"
            type="text"
            placeholder="Supplement"
            value="${defaults.label ?? ""}"
          />
        </td>
        <td>
          <input
            class="inline-table-input supplement-amount"
            type="text"
            inputmode="decimal"
            placeholder="$0.00"
            value="${defaults.amount ?? ""}"
          />
        </td>
        <td>
          <input
            class="inline-table-input supplement-start"
            type="date"
            value="${defaults.startDate ?? ""}"
          />
        </td>
        <td>
          <input
            class="inline-table-input supplement-end"
            type="date"
            value="${defaults.endDate ?? ""}"
          />
        </td>
        <td>
          <select class="inline-table-input supplement-scales">
            <option value="yes" ${defaults.scalesWithFte !== "no" ? "selected" : ""}>Yes</option>
            <option value="no" ${defaults.scalesWithFte === "no" ? "selected" : ""}>No</option>
          </select>
        </td>
        <td>
          <input
            class="inline-table-input supplement-notes"
            type="text"
            placeholder="Optional"
            value="${defaults.notes ?? ""}"
          />
        </td>
        <td class="no-print">
          <button type="button" class="remove-row-button">Remove</button>
        </td>
      `;

      supplementTableBody.appendChild(tr);

      attachTableCurrencyInput(tr.querySelector(".supplement-amount"));

      tr.querySelectorAll("input, select").forEach((input) => {
        if (!input.classList.contains("supplement-amount")) {
          input.addEventListener("input", updateProjection);
          input.addEventListener("change", updateProjection);
        }
      });

      tr.querySelector(".remove-row-button").addEventListener("click", () => {
        tr.remove();
        updateProjection();
      });

      updateProjection();
    }

    function addAccountRow(defaults = {}) {
      const tr = document.createElement("tr");
      tr.className = accountTableBody.children.length % 2 === 0 ? "row-blue-a" : "row-blue-b";

      tr.innerHTML = `
        <td>
          <input
            class="inline-table-input account-name"
            type="text"
            placeholder="Account / Project"
            value="${defaults.name ?? ""}"
          />
        </td>
        <td>
          <input
            class="inline-table-input account-number"
            type="text"
            placeholder="Account number"
            value="${defaults.number ?? ""}"
          />
        </td>
        <td>
          <input
            class="inline-table-input account-loe"
            type="text"
            inputmode="decimal"
            placeholder="0.00%"
            value="${defaults.loe ?? ""}"
          />
        </td>
        <td class="no-print">
          <button type="button" class="remove-row-button">Remove</button>
        </td>
      `;

      accountTableBody.appendChild(tr);

      attachTablePercentInput(tr.querySelector(".account-loe"));

      tr.querySelectorAll("input").forEach((input) => {
        if (!input.classList.contains("account-loe")) {
          input.addEventListener("input", updateProjection);
        }
      });

      tr.querySelector(".remove-row-button").addEventListener("click", () => {
        tr.remove();
        updateProjection();
      });

      updateProjection();
    }

    function readSupplements() {
      return Array.from(supplementTableBody.querySelectorAll("tr")).map((row) => ({
        label: row.querySelector(".supplement-label")?.value.trim() || "Supplement",
        amount: parseNumber(row.querySelector(".supplement-amount")?.value) ?? 0,
        startDate: row.querySelector(".supplement-start")?.value || "",
        endDate: row.querySelector(".supplement-end")?.value || "",
        scalesWithFte: row.querySelector(".supplement-scales")?.value === "yes",
        notes: row.querySelector(".supplement-notes")?.value.trim() || "",
      }));
    }

    function readAccounts() {
      return Array.from(accountTableBody.querySelectorAll("tr")).map((row, index) => ({
        name: row.querySelector(".account-name")?.value.trim() || `Account ${index + 1}`,
        number: row.querySelector(".account-number")?.value.trim() || "—",
        loePct: parseNumber(row.querySelector(".account-loe")?.value) ?? 0,
      }));
    }

    function renderFteTable(rows) {
      fteTableBody.innerHTML = "";

      if (!rows.length) {
        fteEmptyState.hidden = false;
        fteTableWrap.hidden = true;
        return;
      }

      rows.forEach((row, index) => {
        const tr = document.createElement("tr");
        tr.className = index % 2 === 0 ? "row-blue-a" : "row-blue-b";

        tr.innerHTML = `
          <td class="fy-cell">${row.monthLabel}</td>
          <td>
            <input
              class="inline-table-input monthly-fte-override"
              type="text"
              inputmode="decimal"
              placeholder="Use standard"
              data-index="${index}"
              autocomplete="off"
            />
          </td>
          <td class="fte-used">—</td>
        `;

        fteTableBody.appendChild(tr);
      });

      document.querySelectorAll(".monthly-fte-override").forEach((input) => {
        attachTablePercentInput(input);
      });

      fteEmptyState.hidden = true;
      fteTableWrap.hidden = false;
    }

    function resetProjectionResults(message = "Enter projection dates, key inputs, supplements, and LOE accounts to generate results.") {
      projectionTableBody.innerHTML = "";
      projectionEmptyState.textContent = message;
      projectionEmptyState.hidden = false;
      projectionTableWrap.hidden = true;
      projectionScrollHint.hidden = true;

      summaryEmptyState.hidden = false;
      summaryGrid.hidden = true;

      accountSummaryTableBody.innerHTML = "";
      accountSummaryEmptyState.hidden = false;
      accountSummaryTableWrap.hidden = true;
    }

    function updateProjection() {
      const startDate = parseLocalDate(projectionStartInput.value);
      const endDate = parseLocalDate(projectionEndInput.value);

      if (!startDate || !endDate) {
        monthlyRows = [];
        fteTableBody.innerHTML = "";
        fteEmptyState.hidden = false;
        fteTableWrap.hidden = true;
        fteEmptyState.textContent = "Enter a projection start and end date to generate monthly FTE rows.";
        resetProjectionResults();
        return;
      }

      if (endDate < startDate) {
        monthlyRows = [];
        fteTableBody.innerHTML = "";
        fteEmptyState.hidden = false;
        fteTableWrap.hidden = true;
        fteEmptyState.textContent = "Projection end date must be on or after the projection start date.";
        resetProjectionResults("Projection end date must be on or after the projection start date.");
        return;
      }

      if (!monthlyRows.length) {
        monthlyRows = generateMonths(startDate, endDate);
        renderFteTable(monthlyRows);
      } else {
        const expectedRows = generateMonths(startDate, endDate);
        const existingLabels = monthlyRows.map((row) => row.monthLabel).join("|");
        const expectedLabels = expectedRows.map((row) => row.monthLabel).join("|");

        if (existingLabels !== expectedLabels) {
          monthlyRows = expectedRows;
          renderFteTable(monthlyRows);
        }
      }

      calculateProjection();
    }

    function calculateProjection() {
      const annualBaseSalary = parseNumber(baseSalaryInput.value);
      const standardFtePct = parseNumber(standardFteInput.value);
      const fringePct = parseNumber(fringeRateInput.value);
      const supplements = readSupplements();
      const accounts = readAccounts();

      const validAccounts = accounts.filter((account) => account.loePct > 0);
      const validSupplements = supplements.filter((supplement) => supplement.amount > 0);

      const hasInputs =
        annualBaseSalary !== null &&
        standardFtePct !== null &&
        fringePct !== null &&
        monthlyRows.length > 0 &&
        validAccounts.length > 0;

      if (!hasInputs) {
        resetProjectionResults();
        return;
      }

      const standardFte = standardFtePct / 100;
      const fringeRate = fringePct / 100;
      const fteOverrideInputs = document.querySelectorAll(".monthly-fte-override");
      const fteUsedCells = document.querySelectorAll(".fte-used");

      const totals = {
        baseSalary: 0,
        supplement: 0,
        totalSalary: 0,
        fringe: 0,
        totalCost: 0,
        fteSum: 0,
      };

      const accountTotals = new Map();

      projectionTableBody.innerHTML = "";

      monthlyRows.forEach((month, monthIndex) => {
        const overrideValue = parseNumber(fteOverrideInputs[monthIndex]?.value);
        const fteUsed = overrideValue !== null ? overrideValue / 100 : standardFte;

        fteUsedCells[monthIndex].textContent = formatPercent(fteUsed * 100);
        totals.fteSum += fteUsed;

        validAccounts.forEach((account, accountIndex) => {
          const accountLoe = account.loePct / 100;

          const activeSupplementTotal = validSupplements.reduce((sum, supplement) => {
            if (!isSupplementActiveForMonth(supplement, month.monthDate, month.monthEndDate)) {
              return sum;
            }

            const monthlySupplement = supplement.scalesWithFte
              ? (supplement.amount / 12) * fteUsed
              : supplement.amount / 12;

            return sum + monthlySupplement;
          }, 0);

          const baseSalary = (annualBaseSalary / 12) * fteUsed * accountLoe;
          const supplementTotal = activeSupplementTotal * accountLoe;
          const totalSalary = baseSalary + supplementTotal;
          const fringe = totalSalary * fringeRate;
          const totalCost = totalSalary + fringe;

          totals.baseSalary += baseSalary;
          totals.supplement += supplementTotal;
          totals.totalSalary += totalSalary;
          totals.fringe += fringe;
          totals.totalCost += totalCost;

          const accountKey = `${account.name}|${account.number}|${account.loePct}`;

          if (!accountTotals.has(accountKey)) {
            accountTotals.set(accountKey, {
              name: account.name,
              number: account.number,
              loePct: account.loePct,
              baseSalary: 0,
              supplement: 0,
              totalSalary: 0,
              fringe: 0,
              totalCost: 0,
            });
          }

          const accountSummary = accountTotals.get(accountKey);
          accountSummary.baseSalary += baseSalary;
          accountSummary.supplement += supplementTotal;
          accountSummary.totalSalary += totalSalary;
          accountSummary.fringe += fringe;
          accountSummary.totalCost += totalCost;

          const tr = document.createElement("tr");
          tr.className = (monthIndex + accountIndex) % 2 === 0 ? "row-blue-a" : "row-blue-b";

          tr.innerHTML = `
            <td class="fy-cell">${month.monthLabel}</td>
            <td>${account.name}</td>
            <td>${account.number}</td>
            <td>${formatPercent(account.loePct)}</td>
            <td>${formatPercent(fteUsed * 100)}</td>
            <td>${formatCurrency(baseSalary)}</td>
            <td>${formatCurrency(supplementTotal)}</td>
            <td>${formatCurrency(totalSalary)}</td>
            <td>${formatCurrency(fringe)}</td>
            <td>${formatCurrency(totalCost)}</td>
          `;

          projectionTableBody.appendChild(tr);
        });
      });

      const totalLoeAllocated = validAccounts.reduce((sum, account) => sum + account.loePct, 0);
      const averageFte = monthlyRows.length > 0 ? (totals.fteSum / monthlyRows.length) * 100 : 0;

      summaryBaseSalary.textContent = formatCurrency(totals.baseSalary);
      summarySupplement.textContent = formatCurrency(totals.supplement);
      summaryTotalSalary.textContent = formatCurrency(totals.totalSalary);
      summaryFringe.textContent = formatCurrency(totals.fringe);
      summaryTotalCost.textContent = formatCurrency(totals.totalCost);
      summaryTotalLoe.textContent = formatPercent(totalLoeAllocated);
      summaryAverageFte.textContent = formatPercent(averageFte);
      summarySupplementCount.textContent = String(validSupplements.length);
      summaryAccountCount.textContent = String(validAccounts.length);

      renderAccountSummary(Array.from(accountTotals.values()));

      projectionEmptyState.hidden = true;
      projectionTableWrap.hidden = false;
      projectionScrollHint.hidden = false;

      summaryEmptyState.hidden = true;
      summaryGrid.hidden = false;
    }

    function renderAccountSummary(rows) {
      accountSummaryTableBody.innerHTML = "";

      if (!rows.length) {
        accountSummaryEmptyState.hidden = false;
        accountSummaryTableWrap.hidden = true;
        return;
      }

      rows.forEach((row, index) => {
        const tr = document.createElement("tr");
        tr.className = index % 2 === 0 ? "row-blue-a" : "row-blue-b";

        tr.innerHTML = `
          <td class="fy-cell">${row.name}</td>
          <td>${row.number}</td>
          <td>${formatPercent(row.loePct)}</td>
          <td>${formatCurrency(row.baseSalary)}</td>
          <td>${formatCurrency(row.supplement)}</td>
          <td>${formatCurrency(row.totalSalary)}</td>
          <td>${formatCurrency(row.fringe)}</td>
          <td>${formatCurrency(row.totalCost)}</td>
        `;

        accountSummaryTableBody.appendChild(tr);
      });

      accountSummaryEmptyState.hidden = true;
      accountSummaryTableWrap.hidden = false;
    }

    attachFormattedInput(baseSalaryInput, formatCurrencyInput);
    attachFormattedInput(standardFteInput, formatPercentInput);
    attachFormattedInput(fringeRateInput, formatPercentInput);

    [
      projectionStartInput,
      projectionEndInput,
      baseSalaryInput,
      standardFteInput,
      fringeRateInput,
    ].forEach((input) => {
      input?.addEventListener("input", updateProjection);
      input?.addEventListener("change", updateProjection);
    });

    addSupplementButton.addEventListener("click", () => addSupplementRow());
    addAccountButton.addEventListener("click", () => addAccountRow());

    addSupplementRow({
      label: "Supplement Line",
      amount: "",
      scalesWithFte: "yes",
    });

    addAccountRow({
      name: "Account 1",
      number: "",
      loe: "",
    });
